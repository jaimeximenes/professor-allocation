# Hospedagens estáticas (Vercel, Netlify) não executam o json-server.
# Com VITE_API_URL vazio, o build usa o modo demonstração: os dados ficam no
# localStorage do navegador, iniciados a partir de db/seed.json.
# Para usar uma API publicada, defina VITE_API_URL nas variáveis da hospedagem.
VITE_API_URL=
